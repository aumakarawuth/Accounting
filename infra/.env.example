# คัดลอกเป็น infra/.env บน server แล้วใส่ค่า (ไฟล์ .env ไม่ขึ้น git) · สุ่มรหัส: openssl rand -hex 32
# โดเมนที่ผู้ใช้เข้า (ทดสอบบนเครื่อง: localhost)
SITE_ADDRESS=localhost
# ช่วง IP ของ proxy หน้า Caddy (เช่น Cloudflare คั่นด้วยช่องว่าง) ไม่มี proxy = 127.0.0.1/32 (ไม่เชื่อใคร)
TRUSTED_PROXIES=127.0.0.1/32

# superuser ของ Postgres (ใช้เฉพาะ migrate / สร้างผู้ดูแล / backup ภายในเครื่อง)
POSTGRES_PASSWORD=
# login role ของแอป (app_web ∈ app_rw) ≥ 24 ตัว ไม่มีช่องว่าง/อัญประกาศ
APP_DB_PASSWORD=

# monitoring (docker compose --profile monitoring up -d): role monitor ∈ pg_monitor (อ่านสถิติเท่านั้น) และรหัสผู้ดูแล Grafana
MONITOR_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# backup (docs/self-host.md): เวลาไทยที่ทำ base backup + pg_dump ทุกวัน และจำนวนชุดที่เก็บ
BACKUP_AT=02:30
BACKUP_KEEP=7
# ส่งออกนอกเครื่อง (docker compose --profile offsite up -d): remote ชื่อ offsite ตั้งด้วย RCLONE_CONFIG_* ดู docs/self-host.md
OFFSITE_EVERY_MINUTES=15
OFFSITE_PATH=offsite:accounting-backups

# จำกัดอัตรา (docs/load-test.md)
REQUESTS_PER_USER_PER_MINUTE=600
REQUESTS_PER_IP_PER_MINUTE=60000
LOGIN_PER_IP_PER_MINUTE=1200
